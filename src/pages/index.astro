---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/hero.jpg';

const ep = {
  title: 'Zum Wohle der Musik',
  spotify: 'https://open.spotify.com/intl-de/album/63xamqEIwCZcmNJM4cK5yH',
  apple: 'https://music.apple.com/at/album/zum-wohle-der-musik-ep/6832681139',
};

const profiles = [
  { name: 'Spotify', url: 'https://open.spotify.com/intl-de/artist/21cVkZkRtybOwGPOuMi4fv' },
  { name: 'Apple Music', url: 'https://music.apple.com/at/artist/nobel/1579729405' },
  { name: 'Instagram', url: 'https://www.instagram.com/nobelmusik' },
];
---
<Base title="Nobel">
  <main class="root">
    <div class="ext" aria-hidden="true"></div>

    <nav class="legal" aria-label="Rechtliches">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>

    <div class="stage">
      <Picture class="hero" src={hero} formats={['avif', 'webp']} widths={[640, 1024, 1365]}
               sizes="min(100vw, 66.667svh)" loading="eager" fetchpriority="high"
               alt="Nobel streckt sich zwischen weißen Sockeln vor einem blauen Bogen"
               transition:name="hero" />

      <!-- Logo auf der schrägen Säule (Position in % der Bildfläche) -->
      <h1 class="logo">
        <span><img src="/images/logo.png" width="1200" height="301" alt="Nobel" /></span>
      </h1>

      <!-- Links auf der rechten Säule -->
      <nav class="plinth" aria-label="Nobel folgen">
        <p class="label">Nobel folgen</p>
        <ul>
          {profiles.map((p) => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.name}<span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </nav>
    </div>

    <section class="ep" aria-labelledby="ep-title">
      <p class="label">Die EP</p>
      <h2 id="ep-title" transition:name="ep-title">{ep.title}</h2>
      <div class="pills">
        <a class="pill" href={ep.spotify} target="_blank" rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M7 9.5c3.5-1 7-.6 10 1"></path><path d="M7.8 12.8c2.8-.7 5.6-.4 8 .9"></path><path d="M8.6 15.8c2-.5 4-.3 5.8.6"></path></svg>
          Spotify
        </a>
        <a class="pill" href={ep.apple} target="_blank" rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="17" cy="16" r="3"></circle></svg>
          Apple Music
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Bildfläche: 2:3, so groß wie möglich, unten verankert, nie beschnitten */
  .root {
    --stage-w: min(100vw, 66.667svh);
    --stage-h: min(150vw, 100svh);
    --floor-h: min(11.25vw, 7.5svh);
    --edge-mask: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
    position: relative;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background:
      linear-gradient(to bottom, transparent calc(100% - var(--floor-h)), var(--floor-top) calc(100% - var(--floor-h)), var(--floor-bottom) 100%),
      linear-gradient(to right, var(--wall-left), var(--wall-right));
  }

  /* Wand aus der obersten Bildzeile nach oben verlängert */
  .ext {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: var(--stage-w);
    /* reicht 12 % unter die Bildoberkante; dort blendet .hero weich darüber */
    height: calc(100svh - .88 * var(--stage-h));
    background: url('/images/wall-strip.png') no-repeat;
    background-size: 100% 100%;
    --fade: linear-gradient(to bottom, #000 calc(100% - .04 * var(--stage-h)), transparent);
    -webkit-mask-image: var(--edge-mask), var(--fade);
    -webkit-mask-composite: source-in;
    mask-image: var(--edge-mask), var(--fade);
    mask-composite: intersect;
  }

  .legal {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    display: flex;
    gap: 16px;
    padding: 6px 16px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .legal a { padding: 8px 0; text-decoration: none; }
  .legal a:hover { text-decoration: underline; }

  /* EP-Block: vertikal mittig zwischen Seitenrand und Oberkante Bogen (~19 % der Bildhöhe) */
  .ep {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: max(105px, calc((100svh - .81 * var(--stage-h)) / 2));
    transform: translate(-50%, -50%);
    width: min(100%, 520px);
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .ep .label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #24211D;
  }
  .ep h2 {
    margin: 0;
    font-size: clamp(28px, 8.4vw, 40px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.025em;
    color: var(--arch);
    text-shadow: 0 1px 1px rgba(0, 0, 0, .12);
  }
  .pills { margin-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .pill {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: background-color .15s ease, color .15s ease;
  }
  .pill:hover { background: var(--ink); color: #F2F0EC; }
  .pill:focus-visible, .plinth a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .stage {
    position: relative;
    flex: none;
    width: var(--stage-w);
    aspect-ratio: 2 / 3;
    container-type: inline-size;
  }
  .hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    -webkit-mask-image: var(--edge-mask), linear-gradient(to bottom, transparent 0, #000 8%);
    -webkit-mask-composite: source-in;
    mask-image: var(--edge-mask), linear-gradient(to bottom, transparent 0, #000 8%);
    mask-composite: intersect;
  }

  .logo {
    position: absolute;
    left: 28.6%;
    top: 76.1%;
    width: 0;
    height: 0;
    margin: 0;
    filter:
      drop-shadow(-.6px -.6px 0 rgba(255, 255, 255, .55))
      drop-shadow(1.2px 1.6px 0 rgba(0, 0, 0, .55))
      drop-shadow(3px 5px 5px rgba(0, 0, 0, .38));
  }
  .logo span {
    position: absolute;
    left: 0;
    top: 0;
    width: 38cqw;
    display: block;
    transform: translate(-50%, -50%) rotate(-63.5deg);
  }
  .logo img { display: block; width: 100%; height: auto; }

  .plinth {
    position: absolute;
    left: 75.2%;
    top: 77.2%;
    width: 18%;
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    mix-blend-mode: multiply;
    /* Sockelfront im Foto ist ~1,1° im Uhrzeigersinn gedreht */
    transform: rotate(1.1deg);
  }
  .plinth .label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: max(2.1cqw, 9px);
    line-height: 1.25;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #2A2723;
  }
  .plinth ul { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgba(24, 22, 19, .45); }
  .plinth a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.1cqw 0;
    border-top: 1px solid rgba(24, 22, 19, .45);
    font-size: max(3.2cqw, 12px);
    font-weight: 600;
    text-decoration: none;
  }
  .plinth a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
